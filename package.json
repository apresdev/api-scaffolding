{
  "name": "@apresdev/api-scaffolding",
  "homepage": "https://github.com/apresdev/api-scaffolding",
  "version": "0.0.11",
  "description": "",
  "bin": {
    "apres-api": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/apresdev/api-scaffolding"
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint '**/*.{ts,tsx,js,jsx,json}' --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint '**/*.{ts,tsx,js,jsx,json}' --fix --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc.json",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "generate": "npm run generate.openapi",
    "generate.openapi": "npm run generate.openapi.spec && npm run generate.openapi.client",
    "generate.openapi.spec": "npm run generate.openapi.template && npx ts-node src/index.ts openapi",
    "generate.openapi.template": "yq -o=json template.openapi.yaml > src/generators/openapi/template.openapi.json",
    "generate.schema": "for schema in service entities any queries relationships policies fragments; do npm run generate.schema.$schema; done",
    "generate.schema.service": "npx ts-json-schema-generator -f ./tsconfig.json --path 'src/specification/specification.ts' --type 'ServiceSpecification' > src/schemas/service_description.json",
    "generate.schema.entities": "npx ts-json-schema-generator -f ./tsconfig.json --path 'src/specification/entity.ts' --type 'EntitySchema' > src/schemas/model.json",
    "generate.schema.any": "npx ts-json-schema-generator -f ./tsconfig.json --path 'src/specification/entity.ts' --type 'AnySchema' > src/schemas/any.json",
    "generate.schema.queries": "npx ts-json-schema-generator -f ./tsconfig.json --path 'src/specification/specification.ts' --type 'Queries' > src/schemas/queries.json",
    "generate.schema.relationships": "npx ts-json-schema-generator -f ./tsconfig.json --path 'src/specification/specification.ts' --type 'Relationships' > src/schemas/relationships.json",
    "generate.schema.policies": "npx ts-json-schema-generator -f ./tsconfig.json --path 'src/specification/policies.ts' --type 'Policies' > src/schemas/policies.json",
    "generate.schema.fragments": "npx ts-json-schema-generator -f ./tsconfig.json --path 'src/specification/specification.ts' --type 'Fragments' > src/schemas/fragments.json"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.8",
    "@babel/preset-typescript": "^7.24.7",
    "@tsconfig/node20": "^20.1.4",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-love": "^53.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^17.9.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "prettier-plugin-organize-imports": "^4.0.0",
    "ts-json-schema-generator": "^2.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@stoplight/spectral-core": "^1.18.3",
    "@stoplight/spectral-cli": "^6.11.1",
    "@types/ajv": "^1.0.0",
    "@types/ajv-keywords": "^3.5.0",
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.11",
    "@types/underscore": "^1.11.15",
    "ajv": "^8.16.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "ajv-keywords": "^5.1.0",
    "cliui": "^8.0.1",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "js-yaml-source-map": "^0.2.2",
    "openapi-types": "^12.1.3",
    "underscore": "^1.13.7",
    "yaml-import": "^2.0.0"
  }
}
