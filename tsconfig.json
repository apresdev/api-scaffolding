{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,

    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true
  },
  "include": ["./src/**/*", "./test/**/*", "./src/schemas/*.json", "./src/generators/openapi/*.json"],
  "exclude": ["node_modules"]
}
